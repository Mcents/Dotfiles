PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Theme Colors #####
COLORS_FILE="$HOME/.config/sketchybar/colors.sh"
if [ -f "$COLORS_FILE" ]; then
  source "$COLORS_FILE"
else
  export BG="0xff1a1b26"
  export BG_TRANS="0xc01a1b26"
  export FG="0xffc0caf5"
  export ACCENT="0xff7aa2f7"
  export SURFACE="0xff414868"
  export COMMENT="0xff565f89"
  export RED="0xfff7768e"
  export GREEN="0xff9ece6a"
  export YELLOW="0xffe0af68"
  export BLUE="0xff7aa2f7"
  export MAGENTA="0xffad8ee6"
  export CYAN="0xff449dab"
  export ORANGE="0xffeb927b"
fi

##### Bar Appearance #####
# Transparent bar — backgrounds are drawn per-group via brackets
sketchybar --bar position=top height=34 color=0x00000000 \
               y_offset=2 shadow=off

##### Changing Defaults #####
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="Hack Nerd Font:Bold:12.0"
  icon.color=$FG
  label.color=$FG
  icon.padding_left=3
  icon.padding_right=3
  label.padding_left=3
  label.padding_right=3
)
sketchybar --default "${default[@]}"

##### Workspace Indicators (left) #####
sketchybar --add event aerospace_workspace_change

# Padding before first workspace
sketchybar --add item left_pad left \
           --set left_pad icon.drawing=off label.drawing=off padding_left=2 padding_right=0 width=6

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        background.color=$ACCENT \
        background.corner_radius=5 \
        background.height=18 \
        background.drawing=off \
        label="$sid" \
        icon.drawing=off \
        icon.padding_left=0 \
        icon.padding_right=0 \
        label.padding_left=6 \
        label.padding_right=6 \
        padding_left=2 \
        padding_right=2 \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

##### Front App (left) #####
sketchybar --add item chevron left \
           --set chevron icon="›" label.drawing=off icon.color=$ACCENT icon.font="Hack Nerd Font:Bold:18.0" \
           --add item front_app left \
           --set front_app icon.drawing=off label.color=$ACCENT script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Right Items #####
sketchybar --add item clock right \
           --set clock update_freq=10 icon=  script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

##### Brackets — group backgrounds #####
# Left group: workspaces + front app
sketchybar --add bracket left_group left_pad '/space\..*/' chevron front_app \
           --set left_group background.color=$BG_TRANS \
                            background.corner_radius=10 \
                            background.height=26 \
                            background.blur_radius=20

# Right group: clock, volume, battery
sketchybar --add bracket right_group clock volume battery \
           --set right_group background.color=$BG_TRANS \
                             background.corner_radius=10 \
                             background.height=26 \
                             background.blur_radius=20

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
