PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Theme Colors #####
COLORS_FILE="$HOME/.config/sketchybar/colors.sh"
if [ -f "$COLORS_FILE" ]; then
  source "$COLORS_FILE"
else
  export BG="0xff1a1b26"
  export BG_TRANS="0xc01a1b26"
  export FG="0xffc0caf5"
  export ACCENT="0xff7aa2f7"
  export SURFACE="0xff414868"
  export COMMENT="0xff565f89"
  export RED="0xfff7768e"
  export GREEN="0xff9ece6a"
  export YELLOW="0xffe0af68"
  export BLUE="0xff7aa2f7"
  export MAGENTA="0xffad8ee6"
  export CYAN="0xff449dab"
  export ORANGE="0xffeb927b"
fi

##### Bar Appearance #####
# Transparent bar — backgrounds are drawn per-group via brackets
sketchybar --bar position=top height=34 color=0x00000000 \
               y_offset=2 shadow=off margin=4 padding_left=4 padding_right=4

##### Changing Defaults #####
default=(
  padding_left=2
  padding_right=2
  icon.font="Hack Nerd Font:Bold:14.0"
  label.font="Hack Nerd Font:Bold:12.0"
  icon.color=$FG
  label.color=$FG
  icon.padding_left=3
  icon.padding_right=3
  label.padding_left=3
  label.padding_right=3
)
sketchybar --default "${default[@]}"

##### Left — Date/Time #####
sketchybar --add item clock left \
           --set clock update_freq=10 \
                       icon.color=$ACCENT icon.font="Hack Nerd Font:Bold:12.0" \
                       icon.padding_left=8 icon.padding_right=4 \
                       label.padding_left=4 label.padding_right=8 \
                       script="$PLUGIN_DIR/clock.sh"

##### Center — Workspaces + Front App #####
sketchybar --add event aerospace_workspace_change

sketchybar --add item center_pad center \
           --set center_pad icon.drawing=off label.drawing=off padding_left=2 padding_right=0 width=6

for sid in $(aerospace list-workspaces --all); do
    if [ "$sid" = "3" ]; then
        sketchybar --add item chevron center \
            --set chevron icon="›" label.drawing=off icon.color=$ACCENT \
            icon.font="Hack Nerd Font:Bold:18.0" \
            padding_left=4 padding_right=4
    fi
    sketchybar --add item space.$sid center \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        background.color=$ACCENT \
        background.corner_radius=5 \
        background.height=18 \
        background.drawing=off \
        label="$sid" \
        icon.drawing=off \
        icon.padding_left=0 \
        icon.padding_right=0 \
        label.padding_left=6 \
        label.padding_right=6 \
        padding_left=2 \
        padding_right=2 \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

sketchybar --add item center_pad_r center \
           --set center_pad_r icon.drawing=off label.drawing=off padding_left=0 padding_right=2 width=6

sketchybar --add item front_app center \
           --set front_app icon.drawing=off label.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Right — Wifi + Volume + Battery #####
sketchybar --add item wifi right \
           --set wifi update_freq=30 icon.color=$ACCENT icon.padding_right=8 script="$PLUGIN_DIR/wifi.sh" \
           --subscribe wifi wifi_change \
           --add item volume right \
           --set volume icon.color=$ACCENT script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 icon.color=$ACCENT icon.padding_left=8 label.padding_right=8 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

##### Brackets — group backgrounds #####
# Left group: date/time
sketchybar --add bracket left_group clock \
           --set left_group background.color=$BG_TRANS \
                            background.corner_radius=10 \
                            background.height=26 \
                            background.blur_radius=20 \
                            background.border_color=$ACCENT \
                            background.border_width=1

# Center group: workspaces + app icon
sketchybar --add bracket center_group center_pad '/space\..*/' chevron center_pad_r \
           --set center_group background.color=$BG_TRANS \
                              background.corner_radius=10 \
                              background.height=26 \
                              background.blur_radius=20 \
                              background.border_color=$ACCENT \
                              background.border_width=1

# Right group: wifi, volume, battery
sketchybar --add bracket right_group wifi volume battery \
           --set right_group background.color=$BG_TRANS \
                             background.corner_radius=10 \
                             background.height=26 \
                             background.blur_radius=20 \
                             background.border_color=$ACCENT \
                             background.border_width=1

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
